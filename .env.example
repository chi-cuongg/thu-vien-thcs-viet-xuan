# ---- Neon Postgres (CSDL) ----
# Tạo từ Vercel → Storage → Neon (gói Free); Vercel tự điền biến này khi gắn vào project
DATABASE_URL=

# ---- Better Auth (đăng nhập Google) ----
# Chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Địa chỉ website: http://localhost:3000 ở máy local, https://<tên-miền> khi deploy
BETTER_AUTH_URL=http://localhost:3000
# Email được tự cấp quyền admin khi đăng nhập lần đầu, cách nhau bằng dấu phẩy
ADMIN_EMAILS=

# ---- Google (OAuth client dùng cho cả đăng nhập và kho Drive) ----
# Google Cloud project "digitallibrary-483909", client "Web client 1"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Chỉ dùng khi chạy `npm run drive:token` ở máy local; phải có trong "Authorized redirect URIs"
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2/callback
# Refresh token của tài khoản giữ kho sách — lấy bằng: npm run drive:token
GOOGLE_DRIVE_REFRESH_TOKEN=
# Thư mục gốc "ThuVienVietXuan" trên Drive (script ở trên tự tạo nếu để trống)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
