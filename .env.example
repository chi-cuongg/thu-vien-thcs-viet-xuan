# ---- Supabase (CSDL + đăng nhập) ----
NEXT_PUBLIC_SUPABASE_URL=
# anon key hoặc publishable key của project
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server (script import, tác vụ quản trị) — không bao giờ đưa ra client
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Drive (kho file sách) ----
# OAuth client dùng chung Google Cloud project "digitallibrary-483909"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Chỉ dùng khi chạy `npm run drive:token` ở máy local; phải có trong "Authorized redirect URIs"
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2/callback
# Refresh token của tài khoản giữ kho sách — lấy bằng: npm run drive:token
GOOGLE_DRIVE_REFRESH_TOKEN=
# Thư mục gốc "ThuVienVietXuan" trên Drive (script ở trên tự tạo nếu để trống)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
